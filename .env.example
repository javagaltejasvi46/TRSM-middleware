OLLAMA_BASE_URL=http://127.0.0.1:11434
DEFAULT_MODEL=llama3:8b

# Frontend Configuration
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_ENABLE_REVIEWS=false
