# TRSM Global Environment Configuration

# Backend API Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Persistence
DATABASE_URL=sqlite:///./trsm_runtime.db

