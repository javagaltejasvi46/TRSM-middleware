            "title": "Nodes",
            "description": "List of nodes in the workflow"
          },
          "edges": {
            "items": {
              "$ref": "#/components/schemas/EdgeConfig"
            },
            "type": "array",
            "title": "Edges",
            "description": "Directed communication edges between nodes"
          },
          "entry_point": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
