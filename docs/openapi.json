            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "definition": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/WorkflowDefinition"
              },
