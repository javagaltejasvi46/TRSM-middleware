  "components": {
    "schemas": {
      "AgentNodeConfig": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Unique identifier for the agent node"
          },
          "role": {
            "type": "string",
            "title": "Role",
            "description": "Role of the agent (e.g. backend, db_manager, qa, devops)"
          },
          "model": {
            "type": "string",
            "title": "Model",
            "description": "LLM/model identifier or adapter type (e.g. mock, llama3, qwen)"
          },
          "node_type": {
            "type": "string",
            "title": "Node Type",
            "description": "Type of node: agent, human, or resource",
            "default": "agent"
          },
          "allowed_peers": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Allowed Peers",
            "description": "Explicit list of peer node IDs this agent can send messages to"
          },
          "allowed_resources": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Allowed Resources",
            "description": "Allowed tool or database identifiers"
          },
          "system_prompt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "System Prompt",
            "description": "Optional custom system prompt"
          }
        },
        "type": "object",
        "required": [
          "id",
          "role",
          "model"
        ],
        "title": "AgentNodeConfig"
      },
      "AuditEvent": {
        "properties": {
          "event_id": {
            "type": "string",
            "title": "Event Id",
            "description": "Unique event identifier"
          },
          "run_id": {
            "type": "string",
            "title": "Run Id",
            "description": "ID of the workflow run"
          },
          "trace_id": {
            "type": "string",
            "title": "Trace Id",
            "description": "Distributed trace or causality chain ID"
          },
          "parent_event_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Event Id",
            "description": "Causal parent event ID"
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp",
            "description": "ISO 8601 UTC timestamp"
          },
          "event_type": {
            "type": "string",
            "title": "Event Type",
            "description": "Type of event: MESSAGE_PROPOSAL, GATEWAY_DECISION, TOOL_EXECUTION, NODE_START, NODE_END, RUN_START, RUN_END"
          },
          "actor_id": {
            "type": "string",
            "title": "Actor Id",
            "description": "Initiating agent node or system component ID"
          },
          "target_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Id",
            "description": "Target recipient or resource ID"
          },
          "source_type": {
            "type": "string",
            "title": "Source Type",
            "description": "Source type: agent, gateway, tool, orchestrator",
            "default": "agent"
          },
          "trust_labels": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Trust Labels",
            "description": "Security/trust labels (e.g. untrusted_input, verified)"
          },
          "policy_decision": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Policy Decision",
            "description": "ALLOW, BLOCK, QUARANTINE, REVIEW"
          },
          "reason_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason Code",
            "description": "Code explaining policy decision"
          },
          "policy_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Policy Version",
            "description": "Version of the policy rule",
            "default": "v1.0"
          },
          "duration_ms": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Ms",
            "description": "Execution duration in milliseconds"
          },
          "safe_payload_summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Safe Payload Summary",
            "description": "Redacted or safe summary preview"
          },
          "payload_reference": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Payload Reference",
            "description": "Metadata or structured payload references"
          }
        },
        "type": "object",
        "required": [
          "event_id",
          "run_id",
          "trace_id",
          "timestamp",
          "event_type",
          "actor_id"
        ],
        "title": "AuditEvent"
      },
      "EdgeConfig": {
        "properties": {
          "source": {
            "type": "string",
            "title": "Source",
            "description": "Source node ID"
          },
          "target": {
            "type": "string",
            "title": "Target",
            "description": "Target node ID"
          }
        },
        "type": "object",
        "required": [
          "source",
          "target"
        ],
        "title": "EdgeConfig"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "NodeRunLog": {
        "properties": {
          "node_id": {
            "type": "string",
            "title": "Node Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "output": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
