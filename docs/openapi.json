            "description": "Starting agent node ID for execution"
          }
        },
        "type": "object",
        "required": [
          "nodes"
        ],
        "title": "WorkflowDefinition"
      },
      "WorkflowResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "definition": {
            "$ref": "#/components/schemas/WorkflowDefinition"
          }
        },
        "type": "object",
        "required": [
